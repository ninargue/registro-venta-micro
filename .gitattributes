# Normaliza finales de línea: LF en el repositorio y en el working copy, en todos los SO.
* text=auto eol=lf

# Scripts de Windows requieren CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
