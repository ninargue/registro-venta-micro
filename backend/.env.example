# Copia este archivo a backend/.env y completa los valores.
# backend/.env está en .gitignore: nunca se versiona.

# Base de datos local de Supabase (driver async). Las credenciales locales de
# Supabase son públicas, no son secretos. El puerto sale de supabase/config.toml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54422/postgres
