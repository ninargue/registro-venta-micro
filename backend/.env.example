# Copia este archivo a backend/.env y completa los valores.
# backend/.env está en .gitignore: nunca se versiona.
# Valor de ejemplo (no real); el local sale de `supabase status`.

# Base de datos: rol app_api por el pooler de Supabase (modo transacción).
DATABASE_URL=postgresql+asyncpg://app_api:password@localhost:5432/postgres
