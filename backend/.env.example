# Copia este archivo a backend/.env y completa los valores.
# backend/.env está en .gitignore: nunca se versiona.

# Entorno: development | test | staging | production
# En production, COOKIE_SECURE=false está bloqueado al arranque.
APP_ENV=development

# Base de datos local de Supabase (driver async). El puerto sale de supabase/config.toml.
# En runtime usar el rol sin privilegios BYPASSRLS (app_runtime); para migraciones Alembic usar postgres.
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime_dev_password@127.0.0.1:54422/postgres
# Opcional para flujos db-sdd aislados (nunca apuntar DB_TEST_URL a producción/staging):
# DB_TEST_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54422/postgres_test
# DB_DEV_RO_URL=postgresql://agent_ro:readonly_password@127.0.0.1:54422/postgres

# Supabase Auth (prohibido usar service_role en flujos de usuario).
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Sesión JWT y cookies HttpOnly (JWT_SECRET_KEY requiere >= 32 bytes).
JWT_SECRET_KEY=replace-with-at-least-32-bytes-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
COOKIE_SECURE=false
